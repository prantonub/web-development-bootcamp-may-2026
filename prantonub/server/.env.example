# ═══════════════════════════════════════════════════════════════════════════════
# FinanceHub Server Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development
# NODE_ENV can be: development | staging | production

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ Database
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
# MONGO_URI=mongodb://localhost:27017/financehub
# For MongoDB Atlas (production):
MONGO_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/?appName=Cluster0

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
SESSION_SECRET=your_super_secret_session_key_change_this_in_production_12345

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 Frontend URL
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
# CLIENT_URL=http://localhost:5173
# For production (Vercel):
CLIENT_URL=https://financehub-prantonub.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# 📧 Email Verification (Brevo/Sendinblue SMTP)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Email verification is required for user registration!
# 
# Setup Instructions:
# 1. Go to https://www.brevo.com and create a free account
# 2. After login, go to: Settings > SMTP & API
# 3. Generate SMTP credentials:
#    - BREVO_USER: The relay email (looks like: xxxxx@smtp-brevo.com)
#    - BREVO_PASS: The relay password (very long string)
# 4. Set BREVO_SENDER_EMAIL to your actual email or a custom domain email
#
BREVO_USER=your_brevo_relay_email@smtp-brevo.com
BREVO_PASS=your_brevo_smtp_password_very_long_string
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 Google OAuth (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Setup: https://console.cloud.google.com/
# Leave blank or set to "your_google_client_id" to disable OAuth
#
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 AI Chatbot (Groq API + Llama 3.3)
# ─────────────────────────────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/keys
#
GROQ_API_KEY=your_groq_api_key
