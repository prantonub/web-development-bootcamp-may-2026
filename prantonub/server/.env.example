# ═══════════════════════════════════════════════════════════════════════════════
# FinanceHub Server Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development
# NODE_ENV can be: development | staging | production

# Public URL of THIS backend (used for the Google OAuth callback)
# Local: http://localhost:5000   |   Prod: https://your-app.onrender.com
SERVER_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ Database
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
MONGO_URI=mongodb://localhost:27017/financehub
# For MongoDB Atlas (production) — remove the <> brackets around the password:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/financehub?retryWrites=true&w=majority&appName=Cluster0

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
SESSION_SECRET=your_super_secret_session_key_change_this_in_production_12345

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 Frontend URL
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
# CLIENT_URL=http://localhost:5173
# For production (Vercel):
CLIENT_URL=https://financehub-prantonub.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# 📧 Email Verification (Resend) — REQUIRED FOR REGISTRATION
# ─────────────────────────────────────────────────────────────────────────────
# Resend's free plan works WITHOUT a custom domain:
#
# 1. Create a free account at https://resend.com
# 2. Dashboard → API Keys → Create API Key (permission: "Sending access")
# 3. Copy the key (starts with `re_`) into RESEND_API_KEY below
# 4. Leave RESEND_FROM_EMAIL as-is while you have no domain:
#      onboarding@resend.dev is Resend's shared test sender.
#
# ⚠️ Free plan + no verified domain = you can ONLY send to the email address your
#    own Resend account was registered with. To email real users you must verify
#    a domain at https://resend.com/domains and then set RESEND_FROM_EMAIL to
#    e.g. "FinanceHub <noreply@yourdomain.com>".
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=FinanceHub <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 Google OAuth (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Setup: https://console.cloud.google.com/
# Leave blank or set to "your_google_client_id" to disable OAuth
#
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 AI Chatbot (Groq API + Llama 3.3)
# ─────────────────────────────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/keys
#
GROQ_API_KEY=your_groq_api_key
