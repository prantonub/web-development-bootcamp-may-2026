# ═══════════════════════════════════════════════════════════════════════════════
# FinanceHub Server Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development
# NODE_ENV can be: development | staging | production

# Public URL of THIS backend (used for the Google OAuth callback)
# Local: http://localhost:5000   |   Prod: https://your-app.onrender.com
SERVER_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ Database
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
MONGO_URI=mongodb://localhost:27017/financehub
# For MongoDB Atlas (production) — remove the <> brackets around the password:
# MONGO_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/financehub?retryWrites=true&w=majority&appName=Cluster0

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
SESSION_SECRET=your_super_secret_session_key_change_this_in_production_12345

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 Frontend URL
# ─────────────────────────────────────────────────────────────────────────────
# For local development:
# CLIENT_URL=http://localhost:5173
# For production (Vercel):
CLIENT_URL=https://financehub-prantonub.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# 📧 Email Verification (OTP) — REQUIRED FOR REGISTRATION
# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE provider — no code changes needed, it is auto-detected.
# SMTP is checked first because it works WITHOUT owning a domain.
#
# ── Option A (no domain needed — delivers to ANY recipient): SMTP ────────────
#   Gmail example:
#     1. Turn on 2-Step Verification for your Google account
#     2. Create an App Password: https://myaccount.google.com/apppasswords
#     3. SMTP_USER = your Gmail address
#        SMTP_PASS = the 16-character app password (NOT your normal password)
#   Brevo relay example (300 emails/day free):
#     SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#     SMTP_USER=<brevo relay login>    SMTP_PASS=<brevo smtp key>
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional — defaults to "FinanceHub" <SMTP_USER>
SMTP_FROM=
#
# ── Option B: Resend (needs a verified domain for real users) ────────────────
#   ⚠️ Free plan + no verified domain can ONLY send to the address that owns the
#      Resend account. Every other recipient is rejected with a 403.
#   Get a key at https://resend.com/api-keys
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=FinanceHub <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 Google OAuth (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Setup: https://console.cloud.google.com/
# Leave blank or set to "your_google_client_id" to disable OAuth
#
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 AI Chatbot (Groq API + Llama 3.3)
# ─────────────────────────────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/keys
#
GROQ_API_KEY=your_groq_api_key
